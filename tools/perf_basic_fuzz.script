# Deterministic, title-agnostic controller stress sequence for performance
# regression validation. A title-specific gameplay/attract script should run
# separately when one exists; this sequence intentionally also exercises menus.
TURBO ON
WAIT 180
HOLD START
WAIT 2
RELEASE START
WAIT 120
HOLD START
WAIT 2
RELEASE START
WAIT 120
HOLD RIGHT
WAIT 90
HOLD A
WAIT 24
RELEASE A
WAIT 45
HOLD B
WAIT 180
HOLD A
WAIT 30
RELEASE A
WAIT 90
RELEASE B
RELEASE RIGHT
WAIT 60
HOLD LEFT
HOLD B
WAIT 150
HOLD A
WAIT 18
RELEASE A
WAIT 90
RELEASE B
RELEASE LEFT
WAIT 45
HOLD DOWN
WAIT 75
HOLD A
WAIT 12
RELEASE A
RELEASE DOWN
WAIT 45
HOLD UP
WAIT 75
HOLD B
WAIT 60
RELEASE B
RELEASE UP
WAIT 60
HOLD SELECT
WAIT 2
RELEASE SELECT
WAIT 60
HOLD START
WAIT 2
RELEASE START
WAIT 180
EXIT 0
