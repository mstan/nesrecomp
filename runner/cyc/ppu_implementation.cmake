set(NESRECOMP_PPU_IMPL "LLE" CACHE STRING "Cycle PPU implementation (LLE, HLE, FRAME or FRAME_PAL)")
set_property(CACHE NESRECOMP_PPU_IMPL PROPERTY STRINGS LLE HLE FRAME FRAME_PAL)
if(NESRECOMP_PPU_IMPL STREQUAL "LLE")
    add_compile_definitions(NESRECOMP_PPU_HLE=0)
elseif(NESRECOMP_PPU_IMPL STREQUAL "HLE")
    add_compile_definitions(NESRECOMP_PPU_HLE=1)
elseif(NESRECOMP_PPU_IMPL STREQUAL "FRAME")
    add_compile_definitions(NESRECOMP_PPU_HLE=0 NESRECOMP_PPU_FRAME=1)
elseif(NESRECOMP_PPU_IMPL STREQUAL "FRAME_PAL")
    add_compile_definitions(NESRECOMP_PPU_HLE=0 NESRECOMP_PPU_FRAME=1 NESRECOMP_PPU_FRAME_PAL=1)
else()
    message(FATAL_ERROR "NESRECOMP_PPU_IMPL must be LLE, HLE, FRAME or FRAME_PAL")
endif()
message(STATUS "nesrecomp: cycle PPU implementation = ${NESRECOMP_PPU_IMPL} (build-fixed)")
