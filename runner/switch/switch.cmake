# Switch packaging and the small vanilla SDL host. Hardware sources remain in cyc.cmake.
include_guard(GLOBAL)
if(NOT DEFINED NESRECOMP_SWITCH_GAME_DIR)
    set(NESRECOMP_SWITCH_GAME_DIR "" CACHE STRING "Runtime SD directory, e.g. sdmc:/switch/nesrecomp/smb1")
endif()
if(NOT DEFINED NESRECOMP_SWITCH_TITLE)
    set(NESRECOMP_SWITCH_TITLE "NESRecomp" CACHE STRING "HOME/homebrew application name")
endif()
set(NESRECOMP_SWITCH_AUTHOR "NESRecomp contributors" CACHE STRING "NACP author")
set(NESRECOMP_SWITCH_VERSION "0.2.0" CACHE STRING "NACP version")
option(NESRECOMP_SWITCH_SAVES "Enable experimental SD save/load and automatic resume" OFF)
option(NESRECOMP_SWITCH_LTO "Optimize across the Switch runtime's translation units" ON)
set(NESRECOMP_SWITCH_ROMFS_ROOT "" CACHE PATH "Optional caller-owned read-only assets")
option(NESRECOMP_SWITCH_HEADROOM_COUNTERS "Keep the cycle core's host measurement counters (hot-path cost)" OFF)

function(nesrecomp_cyc_enable_switch target)
    if(NOT NESRECOMP_SWITCH_GAME_DIR MATCHES "^sdmc:/[A-Za-z0-9_/-]+$" OR
       NESRECOMP_SWITCH_GAME_DIR MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Set NESRECOMP_SWITCH_GAME_DIR to a per-game sdmc:/ directory")
    endif()
    find_package(SDL2 CONFIG REQUIRED)
    if(NOT TARGET SDL2::SDL2 OR NOT COMMAND nx_create_nro OR NOT COMMAND nx_generate_nacp)
        message(FATAL_ERROR "Switch requires devkitPro switch-sdl2, switch-cmake and switch-tools")
    endif()
    set(dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    get_target_property(sources ${target} SOURCES)
    list(REMOVE_ITEM sources "${NESRECOMP_CYC_DIR}/cyc_diagnostics.c")
    set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
    target_sources(${target} PRIVATE "${dir}/host.c" "${dir}/diagnostics.c")
    target_compile_definitions(${target} PRIVATE CYC_WITH_SDL CYC_SWITCH
        CYC_SWITCH_SAVES=$<BOOL:${NESRECOMP_SWITCH_SAVES}>
        "CYC_SWITCH_VERSION=\"${NESRECOMP_SWITCH_VERSION}\""
        "CYC_SWITCH_GAME_DIR=\"${NESRECOMP_SWITCH_GAME_DIR}\""
        NESRECOMP_HEADROOM_COUNTERS=$<BOOL:${NESRECOMP_SWITCH_HEADROOM_COUNTERS}>)
    target_include_directories(${target} PRIVATE "${dir}")
    target_link_libraries(${target} PRIVATE SDL2::SDL2)
    # The devkitPro SDK supplies -O2 even for Release. Request the hot cycle
    # runtime's intended optimization level after those SDK defaults.
    target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:-O3>")
    target_link_options(${target} PRIVATE "$<$<CONFIG:Release>:-O3>")
    if(NESRECOMP_SWITCH_LTO)
        include(CheckIPOSupported)
        check_ipo_supported(RESULT ipo_supported OUTPUT ipo_error LANGUAGES C)
        if(NOT ipo_supported)
            message(FATAL_ERROR "Switch LTO unavailable: ${ipo_error}; explicitly disable NESRECOMP_SWITCH_LTO to build without it")
        endif()
        set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
    endif()
    set_property(TARGET ${target} PROPERTY NESRECOMP_CYC_SDL TRUE)
    set(nacp "${CMAKE_CURRENT_BINARY_DIR}/${target}.nacp")
    nx_generate_nacp(OUTPUT "${nacp}" NAME "${NESRECOMP_SWITCH_TITLE}"
        AUTHOR "${NESRECOMP_SWITCH_AUTHOR}" VERSION "${NESRECOMP_SWITCH_VERSION}")
    if(NESRECOMP_SWITCH_ROMFS_ROOT)
        if(NOT IS_DIRECTORY "${NESRECOMP_SWITCH_ROMFS_ROOT}")
            message(FATAL_ERROR "Switch ROMFS root must be an existing directory")
        endif()
        file(GLOB_RECURSE romfs_inputs CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE "${NESRECOMP_SWITCH_ROMFS_ROOT}/*")
        set(nro "${CMAKE_CURRENT_BINARY_DIR}/${target}.nro")
        nx_create_nro(${target} OUTPUT "${nro}" NACP "${nacp}" ROMFS "${NESRECOMP_SWITCH_ROMFS_ROOT}")
        add_custom_command(OUTPUT "${nro}" APPEND DEPENDS ${romfs_inputs})
    else()
        nx_create_nro(${target} NACP "${nacp}")
    endif()
endfunction()
